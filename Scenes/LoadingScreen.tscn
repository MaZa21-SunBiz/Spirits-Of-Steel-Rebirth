[sub_resource type="Shader" id="Shader_am871"]
code = "shader_type canvas_item;

uniform float count = 10.0;
void fragment() {
	vec2 conveyor_uv = UV;
	conveyor_uv.x = count * mod(UV.x - TIME/4., 1./count);
	COLOR = texture(TEXTURE, conveyor_uv);
}

"

