[sub_resource type="GDScript" id="GDScript_cp0ys"]
script/source = "extends Control

var countries = []
@onready var country_select = $\"/root/MainMenu/CountrySelect\"
@onready var search_input = country_select.get_node(\"PanelContainer2/TextEdit\")
@onready var entry_list = country_select.get_node(\"ScrollContainer/VBoxContainer\")
@onready var country_info = country_select.get_node(\"CountryInfo\")
var damaged: ShaderMaterial = preload(\"res://damaged.tres\")


func _ready():
	var path = \"res://map_data/map_data.json\" # Ensure path is correct
	if not FileAccess.file_exists(path):
		push_error(\"Map Data JSON missing!\")
		return
	var mapData: Dictionary = {}
	var file = FileAccess.open(path, FileAccess.READ)
	var json_data = JSON.parse_string(file.get_as_text())
	if json_data is Dictionary:
		mapData = json_data
	if MapManager.province_objects.is_empty():
		IdeologyManager.Initialize(mapData[\"ideologies\"] as Dictionary)
		MapManager.load_country_data(mapData[\"provinces\"] as Dictionary)
		CountryManager.initialize_countries(mapData[\"polities\"] as Array[Dictionary])
		MapManager.build_lookup_texture()
		FactionManager.Initialize(mapData[\"factions\"])


func _on_search() -> void:
	for n in entry_list.get_children():
		n.queue_free()
	for country in countries:
		if country.country_name.begins_with(search_input.text):
			var country_entry = 	add_entry(country)
			entry_list.add_child(country_entry)

func add_entry(country):
	var set_country = func():
		CountryManager.set_player_country(country.country_name)
		country_info.text = \"Selected: %s\\n\\nGDP: %d\\nManpower: %d\\nStability: %d\" % [country.country_name.capitalize(), country.gdp, country.manpower, country.stability*100]
	var entry = Button.new()
	entry.text = country.country_name.capitalize()
	entry.icon = TroopManager.get_flag(country.country_name)
	entry.material = damaged
	entry.expand_icon = true
	entry.pressed.connect(set_country)
	return entry

func _on_exit() -> void:
	$\"/root/MainMenu/CountrySelect\".visible = false
"

